<comp lib="0" loc="(70,820)" name="Pin"><a name="tristate" val="false"/><a name="label" val="RC0"/></comp>

<!-- Syndrome S2 = R6 xor R3 xor R2 xor R1 xor RC2 -->
<comp lib="1" loc="(210,620)" name="XOR Gate"><a name="inputs" val="2"/></comp>
<comp lib="1" loc="(330,700)" name="XOR Gate"><a name="inputs" val="2"/></comp>
