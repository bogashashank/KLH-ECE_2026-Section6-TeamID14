<comp lib="1" loc="(1000,760)" name="OR Gate"><a name="inputs" val="2"/></comp>
<comp lib="0" loc="(1090,760)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/><a name="tristate" val="false"/><a name="label" val="ERROR"/><a name="labelloc" val="east"/></comp>

