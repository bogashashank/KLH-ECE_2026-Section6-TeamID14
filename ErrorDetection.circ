<comp lib="0" loc="(70,345)" name="Pin"><a name="tristate" val="false"/><a name="label" val="D0"/></comp>

<!-- c2 = d6 xor d3 xor d2 xor d1 -->
<comp lib="1" loc="(210,180)" name="XOR Gate"><a name="inputs" val="2"/></comp>
<comp lib="1" loc="(210,300)" name="XOR Gate"><a name="inputs" val="2"/></comp>
