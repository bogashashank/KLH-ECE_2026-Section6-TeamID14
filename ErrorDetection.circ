<comp lib="0" loc="(430,240)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/><a name="tristate" val="false"/><a name="label" val="C2"/><a name="labelloc" val="east"/></comp>

<!-- c1 = d7 xor d5 xor d3 xor d2 xor d1 xor d0 -->
<comp lib="1" loc="(210,410)" name="XOR Gate"><a name="inputs" val="2"/></comp>
<comp lib="1" loc="(330,410)" name="XOR Gate"><a name="inputs" val="2"/></comp>
<comp lib="1" loc="(450,410)" name="XOR Gate"><a name="inputs" val="2"/></comp>
<comp lib="1" loc="(570,410)" name="XOR Gate"><a name="inputs" val="2"/></comp>
<comp lib="0" loc="670,410" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/><a name="tristate" val="false"/><a name="label" val="C1"/><a name="labelloc" val="east"/></comp>

<!-- c0 = d7 xor d4 xor d3 xor d2 xor d0 -->
<comp lib="1" loc="(210,350)" name="XOR Gate"><a name="inputs" val="2"/></comp>
<comp lib="1" loc="(330,350)" name="XOR Gate"><a name="inputs" val="2"/></comp>
<comp lib="1" loc="(450,350)" name="XOR Gate"><a name="inputs" val="2"/></comp>
