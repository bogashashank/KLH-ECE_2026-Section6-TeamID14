<!-- Syndrome S0 = R7 xor R4 xor R3 xor R2 xor R0 xor RC0 -->
<comp lib="1" loc="(210,820)" name="XOR Gate"><a name="inputs" val="2"/></comp>
<comp lib="1" loc="(330,820)" name="XOR Gate"><a name="inputs" val="2"/></comp>
