<!-- Titles -->
<comp lib="6" loc="(470,30)" name="Text"><a name="text" val="DIGITAL DATA TRANSMISSION ERROR DETECTION SYSTEM"/><a name="font" val="SansSerif bold 18"/></comp>
<comp lib="6" loc="(240,60)" name="Text"><a name="text" val="TRANSMITTER / CRC ENCODER"/><a name="font" val="SansSerif bold 14"/></comp>
<comp lib="6" loc="(240,500)" name="Text"><a name="text" val="RECEIVER / CRC CHECKER"/><a name="font" val="SansSerif bold 14"/></comp>
<comp lib="6" loc="(740,60)" name="Text"><a name="text" val="Generator: G(x) = x^3 + x + 1"/><a name="font" val="SansSerif plain 12"/></comp>
<comp lib="6" loc="(760,500)" name="Text"><a name="text" val="Valid codeword -> S2=S1=S0=0; otherwise ERROR=1"/><a name="font" val="SansSerif plain 11"/></comp>

<!-- Encoder inputs -->
<comp lib="0" loc="(70,100)" name="Pin"><a name="tristate" val="false"/><a name="label" val="D7"/></comp>
