<comp lib="0" loc="670,660" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/><a name="tristate" val="false"/><a name="label" val="S2"/><a name="labelloc" val="east"/></comp>

<!-- Syndrome S1 = R7 xor R5 xor R2 xor R1 xor R0 xor RC1 -->
<comp lib="1" loc="(210,880)" name="XOR Gate"><a name="inputs" val="2"/></comp>
<comp lib="1" loc="(330,880)" name="XOR Gate"><a name="inputs" val="2"/></comp>
